# Keep the existing single-computer deployment unchanged by leaving
# GO_PIPELINE_NODE_ROLE unset (defaults to all-in-one).

# A computer: controller, UI, project generation and Bug discovery.
# GO_PIPELINE_NODE_ROLE=producer
# GO_TASK_MONITOR_API_HOST=0.0.0.0
# GO_TASK_MONITOR_API_PORT=4174
# GO_TASK_MONITOR_WORK_ROOT=/srv/go-task-monitor-data
# GO_PIPELINE_WORKER_TOKEN=replace-with-at-least-32-random-characters
# GO_PIPELINE_RELEASE_ID=replace-with-the-deployed-git-commit
# Linux/WSL A stores cloud credentials in the process environment rather than macOS Keychain.
# GO_TASK_MONITOR_CLOUD_USERNAME=replace-with-cloud-account
# GO_TASK_MONITOR_CLOUD_PASSWORD=replace-with-cloud-password
# GO_PIPELINE_CLAUDE_BIN=/usr/local/bin/claude
# GO_PIPELINE_CODEX_BIN=/usr/local/bin/codex

# B computer: headless repair worker. Use the same token and Git commit as A.
# GO_TASK_MONITOR_API_URL=http://A_COMPUTER_LAN_OR_TAILSCALE_IP:4174
# GO_PIPELINE_WORKER_ID=repair-b
# GO_PIPELINE_WORKER_ROOT=/srv/go-task-runtime/repair-b
# GO_PIPELINE_WORKER_TOKEN=replace-with-the-same-token-as-A
# GO_PIPELINE_RELEASE_ID=replace-with-the-same-deployed-git-commit
# GO_PIPELINE_REMOTE_BUG_WORKER_LIMIT=4
# GO_PIPELINE_WORKER_STATS_INTERVAL_MS=60000
# GO_PIPELINE_CLAUDE_BIN=/usr/local/bin/claude
# GO_PIPELINE_CODEX_BIN=/usr/local/bin/codex
